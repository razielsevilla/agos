# Copy this file to .env and fill in real values. Never commit .env.

# The municipal code an operator must enter alongside the password to log in.
AGOS_MUNICIPAL_CODE=CABUYAO-CDRRMO

# bcrypt hash of the console password — generate with:
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your-password'))"
AGOS_PASSWORD_HASH=

# Long random string used to sign session cookies — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AGOS_SESSION_SECRET=
